---
import { siteConfig } from '../lib/config';

interface Props {
  q?: string;
  city?: string;
  company?: string;
  category?: string;
  action?: string;
  compact?: boolean;
}
const {
  q = '',
  city = '',
  company = '',
  category = '',
  action = '/vagas',
  compact = false,
} = Astro.props;

const hasAny = Boolean(q || city || company || category);
const activeFilters = [city, company, category].filter(Boolean).length;
---
<section class:list={['market-filters', compact && 'market-filters-compact']} aria-label="Busca de vagas de emprego">
  <form class="market-filters-form" method="get" action={action}>
    <div class="market-search">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Cargo, emprego ou palavra-chave"
        autocomplete="off"
        aria-label="Cargo, emprego ou palavra-chave"
      />
      <button class="market-search-btn" type="submit">
        Buscar
      </button>
    </div>

    <div class="market-filter-grid">
      <label class="market-field">
        <span class="market-field-label">Cidade (local de trabalho)</span>
        <input
          type="text"
          name="city"
          value={city}
          placeholder="Ex.: Niterói, Duque de Caxias"
          list="city-suggestions"
          autocomplete="off"
        />
      </label>

      <label class="market-field">
        <span class="market-field-label">Empresa</span>
        <input type="text" name="company" value={company} placeholder="Nome da empresa" autocomplete="off" />
      </label>

      <label class="market-field">
        <span class="market-field-label">Área / categoria</span>
        <input type="text" name="category" value={category} placeholder="Ex.: Administrativo, Logística" autocomplete="off" />
      </label>
    </div>

    <div class="market-filter-actions">
      <button class="btn market-btn-apply" type="submit">
        {activeFilters > 0 ? `Buscar com filtros (${activeFilters})` : 'Buscar vagas'}
      </button>
      {hasAny && (
        <a class="market-btn-clear" href={action}>Limpar todos os filtros</a>
      )}
      <a class="market-btn-cities" href="/cidades">Ver cidades do RJ</a>
    </div>
  </form>

  <datalist id="city-suggestions">
    {siteConfig.allowedCities.map((c) => <option value={c} />)}
  </datalist>
</section>
