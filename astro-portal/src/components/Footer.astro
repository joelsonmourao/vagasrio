---
import { siteConfig } from '../lib/config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3>{siteConfig.name}</h3>
        <p>
          O {siteConfig.name} reúne vagas de emprego no Rio de Janeiro para facilitar sua busca
          por trabalho na capital, Baixada, Niterói e interior.
        </p>
      </div>
      <div class="footer-col">
        <h4>Emprego no RJ</h4>
        <ul>
          <li><a href="/vagas">Vagas de emprego</a></li>
          <li><a href="/cidades">Vagas por cidade</a></li>
          <li><a href="/categorias">Vagas por área</a></li>
          <li><a href="/empresas">Empresas</a></li>
          <li><a href="/blog">Dicas de carreira</a></li>
          <li><a href="/vagas/estado/rj">Todas as vagas no RJ</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Institucional</h4>
        <ul>
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/contato">Contato</a></li>
          <li><a href="/politica-de-privacidade">Privacidade</a></li>
          <li><a href="/politica-de-cookies">Cookies</a></li>
          <li><a href="/termos-de-uso">Termos</a></li>
          <li><a href="/politica-editorial">Política editorial</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contato</h4>
        <ul>
          <li><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-note">
      <p>© {year} {siteConfig.name}. Divulgação de vagas no estado do Rio de Janeiro (RJ).</p>
    </div>
  </div>
</footer>
