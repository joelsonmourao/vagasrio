---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JobCard from '../../../components/JobCard.astro';
import Pagination from '../../../components/Pagination.astro';
import EmptyState from '../../../components/EmptyState.astro';
import JobsFaq from '../../../components/JobsFaq.astro';
import { cityBySlug, jobList } from '../../../lib/portal';
import { baseUrl, siteConfig } from '../../../lib/config';
import { paginatedPath, parsePageParam } from '../../../lib/pagination-pages';
import { getSiteSettingsSafe, SETTING_KEYS } from '../../../lib/site-settings';
import { getRjJobsFaqs } from '../../../lib/jobs-faq';
import {
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildJobsListingSeo,
  mergeJsonLd,
} from '../../../lib/seo';

const { slug } = Astro.params;
const city = slug ? await cityBySlug(slug) : null;
if (!city) return Astro.redirect('/404');

const settings = await getSiteSettingsSafe();
const brand = settings[SETTING_KEYS.siteName] || siteConfig.name;
const page = parsePageParam(Astro.url.searchParams.get('page'));
const jobsData = await jobList({ page, city: city.slug });
const hasUnsupportedQuery = [...Astro.url.searchParams.keys()].some((key) => key !== 'page');
const pageIsValid = jobsData.totalPages > 0 && page <= jobsData.totalPages;
const canonicalPath =
  pageIsValid && !hasUnsupportedQuery
    ? paginatedPath(`/vagas/cidade/${city.slug}`, page)
    : `/vagas/cidade/${city.slug}`;
const robots =
  jobsData.total > 0 && pageIsValid && !hasUnsupportedQuery
    ? 'index,follow'
    : 'noindex,follow';
const { title: titleBase, description: descriptionBase } = buildJobsListingSeo({
  total: jobsData.total,
  jobTitles: jobsData.jobs.map((j) => j.title),
  placeLabel: `${city.name}, RJ`,
  brand,
  settings,
});
const title = page > 1 && pageIsValid ? `${titleBase} — Página ${page}` : titleBase;
const description =
  page > 1 && pageIsValid
    ? `${descriptionBase} Página ${page} de oportunidades.`
    : descriptionBase;

const faqItems = getRjJobsFaqs({
  brand,
  jobCount: jobsData.total,
  cities: [city.name, ...siteConfig.allowedCities.filter((c) => c !== city.name)],
}).map((item) => {
  if (item.question.includes('Quais cidades')) {
    return {
      ...item,
      question: `Há vagas de emprego em ${city.name}?`,
      answer:
        jobsData.total > 0
          ? `Há ${jobsData.total} vaga${jobsData.total === 1 ? '' : 's'} pública${jobsData.total === 1 ? '' : 's'} em ${city.name}/${city.state} no momento. Use também a busca geral de vagas Rio e empregos RJ.`
          : `No momento, não há vagas públicas ativas em ${city.name}/${city.state}. Volte em breve ou consulte outras cidades do RJ.`,
    };
  }
  return item;
});

const jsonLd =
  page === 1 && !hasUnsupportedQuery
    ? mergeJsonLd(
        buildBreadcrumbSchema(
          [
            { name: 'Início', path: '/' },
            { name: 'Cidades', path: '/cidades' },
            { name: city.name, path: `/vagas/cidade/${city.slug}` },
          ],
          settings,
        ),
        buildFaqPageSchema(
          faqItems.map((f) => ({ question: f.question, answer: f.answer })),
          baseUrl(`/vagas/cidade/${city.slug}`, settings),
        ),
      )
    : undefined;
---
<BaseLayout title={title} description={description} canonical={baseUrl(canonicalPath, settings)} robots={robots} jsonLd={jsonLd}>
  <div class="page-stack page-stack-market">
    <section class="market-top">
      <nav class="breadcrumb">
        <a href="/">Início</a><span>/</span>
        <a href="/cidades">Cidades</a><span>/</span>
        <span>{city.name}</span>
      </nav>
      <h1 class="market-title">Vagas de emprego em {city.name}</h1>
      <p class="market-lead">
        {jobsData.total > 0
          ? `${jobsData.total} vagas de emprego para ${city.name}, RJ. Oportunidades atualizadas de trabalho na região.`
          : `Oportunidades de trabalho em ${city.name}/${city.state}.`}
      </p>
    </section>

    {jobsData.jobs.length > 0 ? (
      <div class="job-grid job-grid-market">
        {jobsData.jobs.map((job) => <JobCard job={job} />)}
      </div>
    ) : (
      <EmptyState
        title={`Nenhuma vaga em ${city.name} no momento`}
        message="Veja outras cidades ou a listagem geral de empregos no RJ."
        clearHref="/cidades"
      />
    )}

    <Pagination
      page={jobsData.page}
      totalPages={jobsData.totalPages}
      basePath={`/vagas/cidade/${city.slug}`}
    />

    <JobsFaq
      items={faqItems}
      title={`Perguntas frequentes — vagas em ${city.name}`}
      lead={`Tire dúvidas sobre empregos em ${city.name} e vagas RJ.`}
    />
  </div>
</BaseLayout>
