---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JobCard from '../../components/JobCard.astro';
import JobFilters from '../../components/JobFilters.astro';
import Pagination from '../../components/Pagination.astro';
import ListingMeta from '../../components/ListingMeta.astro';
import EmptyState from '../../components/EmptyState.astro';
import JobsFaq from '../../components/JobsFaq.astro';
import { jobList } from '../../lib/portal';
import { baseUrl, siteConfig } from '../../lib/config';
import { getSiteSettingsSafe, SETTING_KEYS } from '../../lib/site-settings';
import { getRjJobsFaqs } from '../../lib/jobs-faq';
import {
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildJobsListingSeo,
  mergeJsonLd,
} from '../../lib/seo';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const filterQuery = {
  q: Astro.url.searchParams.get('q') || '',
  city: Astro.url.searchParams.get('city') || '',
  company: Astro.url.searchParams.get('company') || '',
  category: Astro.url.searchParams.get('category') || '',
};
const filters = {
  page,
  q: filterQuery.q || undefined,
  city: filterQuery.city || undefined,
  company: filterQuery.company || undefined,
  category: filterQuery.category || undefined,
};

let jobsData;
try {
  jobsData = await jobList(filters);
} catch {
  jobsData = { jobs: [], total: 0, page: 1, totalPages: 1 };
}

const settings = await getSiteSettingsSafe();
const brand = settings[SETTING_KEYS.siteName] || siteConfig.name;
const hasFilters = !!(filterQuery.q || filterQuery.city || filterQuery.company || filterQuery.category);
const hasQueryString = Astro.url.searchParams.toString().length > 0;
const queryForPager = Object.fromEntries(
  Object.entries(filterQuery).filter(([, v]) => v !== ''),
);

const placeLabel = filterQuery.city?.trim() || 'Rio de Janeiro';
const { title, description } = buildJobsListingSeo({
  total: jobsData.total,
  jobTitles: jobsData.jobs.map((j) => j.title),
  placeLabel,
  brand,
  settings,
});

const faqItems = getRjJobsFaqs({
  brand,
  jobCount: jobsData.total,
  cities: siteConfig.allowedCities,
});

const jsonLd = !hasQueryString
  ? mergeJsonLd(
      buildBreadcrumbSchema(
        [
          { name: 'Início', path: '/' },
          { name: 'Vagas de emprego no RJ', path: '/vagas' },
        ],
        settings,
      ),
      buildFaqPageSchema(
        faqItems.map((f) => ({ question: f.question, answer: f.answer })),
        baseUrl('/vagas', settings),
      ),
    )
  : undefined;
---
<BaseLayout
  title={title}
  description={description}
  canonical={baseUrl('/vagas')}
  robots={hasQueryString ? 'noindex,follow' : undefined}
  jsonLd={jsonLd}
>
  <div class="page-stack page-stack-market">
    <section class="market-top">
      <h1 class="market-title">Vagas de emprego em Rio de Janeiro</h1>
      <p class="market-lead">
        {jobsData.total > 0
          ? `${jobsData.total} vagas de emprego para Rio de Janeiro. Filtre por cargo, cidade e empresa — empregos RJ e vagas rio atualizadas.`
          : 'Encontre oportunidades de trabalho no Rio de Janeiro. Use os filtros ou '}
        {jobsData.total === 0 && <a href="/cidades">navegue por cidade</a>}
        {jobsData.total === 0 && '.'}
      </p>
      <JobFilters {...filterQuery} />
    </section>

    {jobsData.total > 0 && (
      <ListingMeta page={jobsData.page} totalPages={jobsData.totalPages} total={jobsData.total} noun="vagas" />
    )}

    {jobsData.jobs.length > 0 ? (
      <div class="job-grid job-grid-market">
        {jobsData.jobs.map((job) => <JobCard job={job} />)}
      </div>
    ) : (
      <EmptyState
        title="Nenhuma vaga encontrada"
        message={hasFilters
          ? 'Não encontramos empregos com esses filtros. Limpe a busca ou escolha outra cidade.'
          : 'Ainda não há vagas públicas no site.'}
        clearHref={hasFilters ? '/vagas' : undefined}
      />
    )}

    <Pagination page={jobsData.page} totalPages={jobsData.totalPages} basePath="/vagas" query={queryForPager} />

    {!hasQueryString && <JobsFaq items={faqItems} />}
  </div>
</BaseLayout>
