---
import BaseLayout from '../layouts/BaseLayout.astro';
import { institutionalPages } from '../lib/institutional';
import { baseUrl, siteConfig } from '../lib/config';
import { getSiteSettingsSafe, SETTING_KEYS } from '../lib/site-settings';

const cfg = siteConfig;
const page = institutionalPages.contato;
const settings = await getSiteSettingsSafe();
const email = settings[SETTING_KEYS.contactEmail] || cfg.contactEmail;
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error') || '';
---
<BaseLayout title={`${page.title} - ${siteConfig.name}`} description={page.description} canonical={baseUrl('/contato', settings)}>
  <h1>{page.title}</h1>
  <div class="prose" set:html={page.html.replace(/contato@vagasrj\.rio\.br/g, email)} />

  {sent && <p class="flash-ok">Mensagem enviada. Responderemos pelo e-mail informado, em prazo razoável.</p>}
  {error && <p class="flash-error">{decodeURIComponent(error)}</p>}

  <section class="panel contact-form-panel" aria-labelledby="contact-form-title">
    <h2 id="contact-form-title">Formulário de contato</h2>
    <form method="post" action="/api/contact" class="admin-form admin-form-stacked contact-form">
      <label>
        Nome
        <input type="text" name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label>
        E-mail
        <input type="email" name="email" required maxlength="160" autocomplete="email" />
      </label>
      <label>
        Assunto
        <select name="subject" required>
          <option value="duvida">Dúvida geral</option>
          <option value="correcao">Correção de vaga</option>
          <option value="privacidade">Privacidade / LGPD</option>
          <option value="publicidade">Publicidade / AdSense</option>
          <option value="outro">Outro</option>
        </select>
      </label>
      <label>
        Mensagem
        <textarea name="message" required rows="6" maxlength="4000" placeholder="Descreva sua solicitação com clareza."></textarea>
      </label>
      {/* honeypot */}
      <label class="visually-hidden" aria-hidden="true">
        Não preencha
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <button class="btn" type="submit">Enviar mensagem</button>
    </form>
    <p class="admin-hint">Ou escreva direto para <a href={`mailto:${email}`}>{email}</a>.</p>
  </section>
</BaseLayout>
