---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobCard from '../components/JobCard.astro';
import BlogCard from '../components/BlogCard.astro';
import JobFilters from '../components/JobFilters.astro';
import JobsFaq from '../components/JobsFaq.astro';
import { homeData } from '../lib/portal';
import { baseUrl, siteConfig } from '../lib/config';
import { getSiteSettingsSafe, SETTING_KEYS } from '../lib/site-settings';
import { getRjJobsFaqs } from '../lib/jobs-faq';
import {
  buildFaqPageSchema,
  buildHomeSeoDefaults,
  buildJobsListingSeo,
  buildPublisherOrganizationSchema,
  buildWebSiteSchema,
  mergeJsonLd,
} from '../lib/seo';

let data;
try {
  data = await homeData();
} catch {
  data = { featuredJobs: [], recentPosts: [], stats: { jobs: 0, activeJobs: 0, posts: 0, companies: 0, cities: 0 } };
}

const settings = await getSiteSettingsSafe();
const brand = settings[SETTING_KEYS.siteName] || siteConfig.name;
const jobCount = data.stats.activeJobs || data.stats.jobs || 0;
const listingSeo = buildJobsListingSeo({
  total: jobCount,
  jobTitles: data.featuredJobs.map((j) => j.title),
  placeLabel: 'Rio de Janeiro',
  brand,
  settings,
});
const homeDefaults = buildHomeSeoDefaults(settings);
// Preferir snippet dinâmico (contagem + cargos) quando houver vagas; senão defaults do painel
const title = jobCount > 0 ? listingSeo.title : homeDefaults.title;
const description = jobCount > 0 ? listingSeo.description : homeDefaults.description;

const faqItems = getRjJobsFaqs({
  brand,
  jobCount,
  cities: siteConfig.allowedCities,
});

const jsonLd = mergeJsonLd(
  buildWebSiteSchema(settings),
  buildPublisherOrganizationSchema(settings),
  buildFaqPageSchema(
    faqItems.map((f) => ({ question: f.question, answer: f.answer })),
    baseUrl('/', settings),
  ),
);
---
<BaseLayout title={title} description={description} canonical={baseUrl('/', settings)} jsonLd={jsonLd}>
  <section class="market-top">
    <p class="market-kicker">{brand} · Empregos no Rio de Janeiro</p>
    <h1 class="market-title">Vagas de emprego no Rio de Janeiro</h1>
    <p class="market-lead">
      Busque <strong>vagas Rio</strong>, <strong>empregos RJ</strong> e oportunidades por cargo e cidade.
      Grátis para candidatos em todo o estado do Rio de Janeiro
      {jobCount > 0 ? ` — ${jobCount} vaga${jobCount === 1 ? '' : 's'} pública${jobCount === 1 ? '' : 's'} agora` : ''}.
    </p>
    <JobFilters compact />
  </section>

  <section class="home-section home-section-jobs">
    <div class="section-head section-head-market">
      <h2>Vagas em destaque</h2>
      <a class="section-link" href="/vagas">Ver todas as vagas</a>
    </div>
    <div class="job-grid job-grid-market">
      {data.featuredJobs.map((job) => <JobCard job={job} />)}
    </div>
    {data.featuredJobs.length === 0 && (
      <p class="section-text">
        Ainda não há vagas públicas ativas. <a href="/vagas">Explorar vagas</a> ou
        <a href="/cidades">ver cidades</a>.
      </p>
    )}
  </section>

  <section class="home-section">
    <div class="section-head section-head-market">
      <h2>Empregos por cidade no RJ</h2>
      <a class="section-link" href="/cidades">Todas as cidades</a>
    </div>
    <div class="city-chips">
      {siteConfig.allowedCities.slice(0, 8).map((name) => (
        <a class="city-chip" href={`/vagas?city=${encodeURIComponent(name)}`}>{name}</a>
      ))}
    </div>
    <p class="section-text" style="margin-top:12px">
      Prefere filtrar por área? <a href="/categorias">Ver vagas por categoria</a>.
    </p>
  </section>

  {data.recentPosts.length > 0 && (
    <section class="home-section">
      <div class="section-head section-head-market">
        <h2>Dicas de emprego e carreira</h2>
        <a class="section-link" href="/blog">Ver blog</a>
      </div>
      <div class="entity-grid blog-grid blog-grid-compact">
        {data.recentPosts.map((post) => <BlogCard article={post} />)}
      </div>
    </section>
  )}

  <JobsFaq items={faqItems} />
</BaseLayout>
