---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Pagination from '../../components/Pagination.astro';
import ListingMeta from '../../components/ListingMeta.astro';
import EmptyState from '../../components/EmptyState.astro';
import { articleList } from '../../lib/portal';
import { baseUrl, siteConfig } from '../../lib/config';
import { getSiteSettingsSafe } from '../../lib/site-settings';
import { paginatedPath, parsePageParam } from '../../lib/pagination-pages';
import {
  buildBreadcrumbSchema,
  buildRelatedPostsItemListSchema,
  mergeJsonLd,
} from '../../lib/seo';

const page = parsePageParam(Astro.url.searchParams.get('page'));
const hasUnsupportedQuery = [...Astro.url.searchParams.keys()].some((key) => key !== 'page');
const data = await articleList({ page });
const settings = await getSiteSettingsSafe();
const pageIsValid = page <= data.totalPages;
const canonical = baseUrl(
  pageIsValid ? paginatedPath('/blog', page) : '/blog',
  settings,
);
const titleBase = `Dicas de Emprego e Carreira no RJ | ${siteConfig.name}`;
const descriptionBase = `Artigos sobre currículo, entrevista, segurança e primeiro emprego no Rio de Janeiro. Conteúdo do ${siteConfig.name}.`;
const title = page > 1 && pageIsValid ? `${titleBase} — Página ${page}` : titleBase;
const description = page > 1 && pageIsValid
  ? `${descriptionBase} Página ${page} da coleção.`
  : descriptionBase;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonical,
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.name,
    url: baseUrl('/', settings),
  },
  about: {
    '@type': 'Thing',
    name: 'Emprego e carreira no Rio de Janeiro',
  },
};

const jsonLd = mergeJsonLd(
  collectionSchema,
  buildBreadcrumbSchema(
    [
      { name: 'Início', path: '/' },
      { name: 'Dicas de emprego', path: '/blog' },
    ],
    settings,
  ),
  buildRelatedPostsItemListSchema(
    data.articles.map((a) => ({ title: a.title, slug: a.slug })),
    settings,
  ),
);
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots={hasUnsupportedQuery || !pageIsValid ? 'noindex,follow' : undefined}
  jsonLd={jsonLd}
>
  <div class="page-stack page-stack-market">
    <section class="market-top">
      <h1 class="market-title">Dicas de emprego</h1>
      <p class="market-lead">
        Guias práticos para quem busca vaga no Rio de Janeiro: currículo, entrevista, direitos e segurança.
      </p>
    </section>

    {data.total > 0 && (
      <ListingMeta page={data.page} totalPages={data.totalPages} total={data.total} noun="artigos" countMode="published" />
    )}

    {data.articles.length > 0 ? (
      <div class="entity-grid blog-grid blog-grid-list">
        {data.articles.map((article) => <BlogCard article={article} />)}
      </div>
    ) : (
      <EmptyState title="Nenhum artigo publicado" message="Em breve publicaremos dicas de carreira." />
    )}

    <Pagination page={data.page} totalPages={data.totalPages} basePath="/blog" />
  </div>
</BaseLayout>
