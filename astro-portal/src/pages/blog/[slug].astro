---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleBySlug, articleList } from '../../lib/portal';
import {
  buildArticleSchema,
  buildBlogPageTitle,
  buildBlogPageDescription,
  buildBreadcrumbSchema,
  buildFaqPageSchema,
  buildHowToSchema,
  buildRelatedPostsItemListSchema,
  blogCanonical,
  blogRobotsMeta,
  extractFaqPairsFromHtml,
  extractHowToStepsFromHtml,
  mergeJsonLd,
} from '../../lib/seo';
import { getSiteSettingsSafe, isIndexingEnabled } from '../../lib/site-settings';
import { formatDateBr } from '../../lib/format';
import { formatSchemaDateTime } from '../../lib/datetime-brazil';
import { absoluteUrl, baseUrl, siteConfig } from '../../lib/config';

const { slug } = Astro.params;
const article = slug ? await articleBySlug(slug) : null;
if (!article) return Astro.redirect('/404');

const settings = await getSiteSettingsSafe();
const indexingOn = isIndexingEnabled(settings);
const title = buildBlogPageTitle(article, settings);
const description = buildBlogPageDescription(article);
const canonical = blogCanonical(article, settings);
const robots = blogRobotsMeta(article, indexingOn);
const cover = article.featuredImage?.trim() || '';
const ogImage = cover ? (cover.startsWith('http') ? cover : absoluteUrl(cover, settings)) : undefined;
const pageUrl = baseUrl(`/blog/${article.slug}`, settings);
const coverAbs = ogImage || absoluteUrl('/assets/img/og-vagas-rj.png', settings);

const more = await articleList({ page: 1, perPage: 6, category: article.category.slug });
const related = more.articles.filter((a) => a.slug !== article.slug).slice(0, 5);

const faqPairs = extractFaqPairsFromHtml(article.content || '');
const howToSteps = extractHowToStepsFromHtml(article.content || '');

const jsonLd = mergeJsonLd(
  buildArticleSchema(article, settings),
  buildBreadcrumbSchema(
    [
      { name: 'Início', path: '/' },
      { name: 'Dicas de emprego', path: '/blog' },
      { name: article.title, path: `/blog/${article.slug}` },
    ],
    settings,
  ),
  buildFaqPageSchema(faqPairs, pageUrl),
  buildHowToSchema(article.title, article.excerpt || description, howToSteps, pageUrl, coverAbs),
  buildRelatedPostsItemListSchema(
    related.map((a) => ({ title: a.title, slug: a.slug })),
    settings,
  ),
);
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots={robots}
  jsonLd={jsonLd}
  ogType="article"
  ogImage={ogImage}
  publishedTime={formatSchemaDateTime(article.publishedAt)}
  modifiedTime={formatSchemaDateTime(article.updatedAt)}
  articleSection={article.category.name}
>
  <nav class="breadcrumb" aria-label="Navegação">
    <a href="/">Início</a><span>/</span>
    <a href="/blog">Dicas de emprego</a><span>/</span>
    <span>{article.title}</span>
  </nav>

  <div class="article-page">
    <div class="article-page-grid">
      {/* Sem microdata itemscope: evita Article/BlogPosting duplicado no Google */}
      <article class="article-content">
        <header class="panel article-header">
          <p class="article-meta-kicker">{article.category.name}</p>
          <h1>{article.title}</h1>
          <p class="article-byline">
            <span>{`Redação ${siteConfig.name}`}</span>
            <span aria-hidden="true"> · </span>
            <time datetime={formatSchemaDateTime(article.publishedAt)}>
              Publicado em {formatDateBr(article.publishedAt)}
            </time>
          </p>
          {article.excerpt && <p class="article-deck">{article.excerpt}</p>}
        </header>
        {cover && (
          <figure class="article-cover">
            <img
              src={cover}
              alt={`Imagem de destaque: ${article.title}`}
              width="1200"
              height="675"
              loading="eager"
            />
          </figure>
        )}
        <div class="panel prose article-body" set:html={article.content} />
      </article>
      {related.length > 0 && (
        <aside class="article-sidebar">
          <h2>Leia também</h2>
          <ul class="article-related-list">
            {related.map((a) => (
              <li><a href={`/blog/${a.slug}`}>{a.title}</a></li>
            ))}
          </ul>
          <p class="article-sidebar-note">
            Conteúdo editorial do {siteConfig.name} sobre emprego no Rio de Janeiro.
          </p>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
