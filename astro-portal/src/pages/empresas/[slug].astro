---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JobCard from '../../components/JobCard.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { companyBySlug, jobList } from '../../lib/portal';
import { baseUrl } from '../../lib/config';
import { paginatedPath, parsePageParam } from '../../lib/pagination-pages';
import { getSiteSettingsSafe, SETTING_KEYS } from '../../lib/site-settings';
import { buildCompanyPageTitle, buildOrganizationSchema, buildBreadcrumbSchema, mergeJsonLd } from '../../lib/seo';

const { slug } = Astro.params;
const company = slug ? await companyBySlug(slug) : null;
if (!company) return Astro.redirect('/404');

const settings = await getSiteSettingsSafe();
const page = parsePageParam(Astro.url.searchParams.get('page'));
const jobsData = await jobList({ company: company.slug, page });
const hasUnsupportedQuery = [...Astro.url.searchParams.keys()].some((key) => key !== 'page');
const pageIsValid = jobsData.totalPages > 0 && page <= jobsData.totalPages;
const canonicalPath =
  pageIsValid && !hasUnsupportedQuery
    ? paginatedPath(`/empresas/${company.slug}`, page)
    : `/empresas/${company.slug}`;
const titleBase = buildCompanyPageTitle(company.name, settings);
const title = page > 1 && pageIsValid ? `${titleBase} — Página ${page}` : titleBase;
const descriptionBase = jobsData.total > 0
  ? `Confira vagas de emprego na ${company.name} no Rio de Janeiro (RJ). Oportunidades atualizadas no ${settings[SETTING_KEYS.siteName] || 'Vagas RJ RIO'}.`
  : `${company.name} não possui vagas públicas ativas no momento. Consulte outras oportunidades no Rio de Janeiro (RJ).`;
const description =
  page > 1 && pageIsValid
    ? `${descriptionBase} Página ${page} de oportunidades.`
    : descriptionBase;
const robots =
  jobsData.total > 0 && pageIsValid && !hasUnsupportedQuery
    ? 'index,follow'
    : 'noindex,follow';
const jsonLd =
  page === 1 && !hasUnsupportedQuery
    ? mergeJsonLd(
        buildOrganizationSchema(company, settings),
        buildBreadcrumbSchema(
          [
            { name: 'Início', path: '/' },
            { name: 'Empresas', path: '/empresas' },
            { name: company.name, path: `/empresas/${company.slug}` },
          ],
          settings,
        ),
      )
    : undefined;
---
<BaseLayout title={title} description={description} canonical={baseUrl(canonicalPath, settings)} robots={robots} jsonLd={jsonLd}>
  <div class="page-stack">
    <header class="page-hero page-hero-compact">
      <div class="page-hero-inner">
        <p class="section-kicker" style="color:#93c5fd;margin:0 0 8px">Empresa</p>
        <h1>Vagas na {company.name}</h1>
        {company.description ? <p>{company.description}</p> : (
          <p>Oportunidades publicadas pela {company.name} no Rio de Janeiro.</p>
        )}
        {jobsData.total > 0 && (
          <p class="page-hero-count">{jobsData.total} vaga{jobsData.total !== 1 ? 's' : ''}</p>
        )}
      </div>
    </header>

    <nav class="breadcrumb">
      <a href="/">Início</a><span>/</span>
      <a href="/empresas">Empresas</a><span>/</span>
      <span>{company.name}</span>
    </nav>

    {jobsData.jobs.length > 0 ? (
      <div class="job-grid job-grid-listing">
        {jobsData.jobs.map((job) => <JobCard job={job} />)}
      </div>
    ) : (
      <EmptyState title="Sem vagas abertas" message="Esta empresa não possui vagas ativas no momento." clearHref="/vagas" />
    )}

    <Pagination
      page={jobsData.page}
      totalPages={jobsData.totalPages}
      basePath={`/empresas/${company.slug}`}
    />
  </div>
</BaseLayout>
